rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global safety net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Pinnwand Validation Helpers ---
    function isValidPinnwandNoteOnCreate(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.text is string && data.text.size() <= 1000 &&
             data.category is string && (data.category == 'NOTE' || data.category == 'TASK' || data.category == 'PROCESS' || data.category == 'KPI' || data.category == 'FOKUS') &&
             data.createdAt == request.time &&
             data.dateLabel is string && data.dateLabel.size() <= 100 &&
             data.weekNumber is int &&
             data.userId == request.auth.uid &&
             data.userEmail is string && data.userEmail.size() <= 200;
    }

    function isValidPinnwandNoteOnUpdate(data, prev) {
      return data.id is string && data.id.size() <= 128 &&
             data.text is string && data.text.size() <= 1000 &&
             data.category is string && (data.category == 'NOTE' || data.category == 'TASK' || data.category == 'PROCESS' || data.category == 'KPI' || data.category == 'FOKUS') &&
             data.createdAt == prev.createdAt &&
             data.dateLabel is string && data.dateLabel.size() <= 100 &&
             data.weekNumber is int &&
             data.userId == prev.userId &&
             data.userEmail is string && data.userEmail.size() <= 200;
    }

    // --- Whiteboard Note Validation Helpers ---
    function isValidWhiteboardNoteOnCreate(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.text is string && data.text.size() <= 500 &&
             data.color is string && data.color.size() <= 30 &&
             data.x is number &&
             data.z is number &&
             data.rotationZ is number &&
             data.createdAt == request.time &&
             data.userId == request.auth.uid &&
             data.userEmail is string && data.userEmail.size() <= 200;
    }

    // --- Whiteboard Note Validation Helpers ---
    function isValidWhiteboardNoteOnUpdate(data, prev) {
      return data.id is string && data.id.size() <= 128 &&
             data.text is string && data.text.size() <= 500 &&
             data.color is string && data.color.size() <= 30 &&
             data.x is number &&
             data.z is number &&
             data.rotationZ is number &&
             data.createdAt == prev.createdAt &&
             data.userId == prev.userId &&
             data.userEmail is string && data.userEmail.size() <= 200;
    }

    // --- Whiteboard Config Validation Helpers ---
    function isValidWhiteboardConfigOnCreate(data) {
      return data.text is string && data.text.size() <= 50000 &&
             data.updatedAt == request.time &&
             data.lastUpdatedBy is string && data.lastUpdatedBy.size() <= 200;
    }

    function isValidWhiteboardConfigOnUpdate(data, prev) {
      return data.text is string && data.text.size() <= 50000 &&
             data.updatedAt == request.time &&
             data.lastUpdatedBy is string && data.lastUpdatedBy.size() <= 200;
    }

    // --- 2. Pinnwand Notes Collection Rules ---
    match /pinnwand_notes/{noteId} {
      allow read, list: if isVerified();
      
      allow create: if isVerified() && 
                       isValidId(noteId) && 
                       isValidPinnwandNoteOnCreate(incoming());
                       
      allow update: if isVerified() && 
                       isValidId(noteId) && 
                       isValidPinnwandNoteOnUpdate(incoming(), existing()) && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['text', 'category', 'dateLabel', 'weekNumber', 'tags']);
                       
      allow delete: if isVerified() && 
                       isValidId(noteId);
    }

    // --- 3. Whiteboard Notes Collection Rules ---
    match /whiteboard_notes/{noteId} {
      allow read, list: if isVerified();
      
      allow create: if isVerified() && 
                       isValidId(noteId) && 
                       isValidWhiteboardNoteOnCreate(incoming());
                       
      allow update: if isVerified() && 
                       isValidId(noteId) && 
                       isValidWhiteboardNoteOnUpdate(incoming(), existing()) && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['x', 'z', 'rotationZ', 'text', 'color']);
                       
      allow delete: if isVerified() && 
                       isValidId(noteId);
    }

    // --- 4. Whiteboard Central Config Rules ---
    match /whiteboard_config/{configId} {
      allow read, list: if isVerified();
      
      allow create: if isVerified() && 
                       isValidId(configId) && 
                       isValidWhiteboardConfigOnCreate(incoming());
                       
      allow update: if isVerified() && 
                       isValidId(configId) && 
                       isValidWhiteboardConfigOnUpdate(incoming(), existing()) && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt', 'lastUpdatedBy']);
                       
      allow delete: if false; // Board config is permanent
    }

    // --- VayBoard Validation Helpers (SPEC-TECH-001 hardened) ---
    // Shared model: any verified user may read/write/delete. These helpers add
    // schema/type/enum/size validation and reject foreign fields. Optional fields
    // are checked only when present so partial creates/updates still succeed.
    function isValidCardData(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 500 &&
             data.sourceType in ['YOUTUBE', 'PDF', 'TEXT', 'VOICE', 'TEAM'] &&
             (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 5000)) &&
             (!('rawText' in data) || (data.rawText is string && data.rawText.size() <= 900000)) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 200000)) &&
             (!('projectRelevance' in data) || (data.projectRelevance is string && data.projectRelevance.size() <= 50000)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 500)) &&
             (!('roles' in data) || (data.roles is list && data.roles.size() <= 500)) &&
             (!('nextActions' in data) || (data.nextActions is list && data.nextActions.size() <= 500)) &&
             (!('status' in data) || data.status in ['NEW', 'PROCESSED', 'ARCHIVED']) &&
             (!('importance' in data) || data.importance in ['LOW', 'MEDIUM', 'HIGH']);
    }

    function isValidBoardItemData(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.boardId is string && data.boardId.size() <= 128 &&
             data.x is number && data.y is number &&
             (!('cardId' in data) || (data.cardId is string && data.cardId.size() <= 128)) &&
             (!('width' in data) || data.width is number) &&
             (!('height' in data) || data.height is number) &&
             (!('groupId' in data) || (data.groupId is string && data.groupId.size() <= 128)) &&
             (!('groupColor' in data) || (data.groupColor is string && data.groupColor.size() <= 500)) &&
             (!('groupTitle' in data) || (data.groupTitle is string && data.groupTitle.size() <= 500)) &&
             (!('connectedTo' in data) || (data.connectedTo is list && data.connectedTo.size() <= 1000));
    }

    function isValidAgentEventData(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.agent in ['STRATEGY', 'CREATIVE', 'OPERATIONS'] &&
             data.cardId is string && data.cardId.size() <= 128 &&
             data.status in ['PENDING', 'PROCESSED'] &&
             (!('triggerType' in data) || (data.triggerType is string && data.triggerType.size() <= 500)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 10000));
    }

    // --- VayBoard Collections Rules (SPEC-TECH-001 hardened) ---
    match /cards/{cardId} {
      allow read, list: if isVerified();

      allow create: if isVerified() && isValidId(cardId) &&
                       incoming().keys().hasOnly(['id', 'title', 'sourceType', 'createdAt', 'updatedAt', 'sourceUrl', 'rawText', 'summary', 'tags', 'roles', 'projectRelevance', 'nextActions', 'status', 'importance']) &&
                       isValidCardData(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isVerified() && isValidId(cardId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'sourceType', 'sourceUrl', 'rawText', 'summary', 'tags', 'roles', 'projectRelevance', 'nextActions', 'status', 'importance', 'updatedAt']) &&
                       isValidCardData(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time;

      allow delete: if isVerified() && isValidId(cardId);
    }

    match /boards/{boardId} {
      allow read, list: if isVerified();

      allow create: if isVerified() && isValidId(boardId) &&
                       incoming().keys().hasOnly(['id', 'name', 'createdAt']) &&
                       incoming().id is string && incoming().id.size() <= 128 &&
                       incoming().name is string && incoming().name.size() <= 200 &&
                       incoming().createdAt == request.time;

      allow update: if isVerified() && isValidId(boardId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name']) &&
                       incoming().name is string && incoming().name.size() <= 200 &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isVerified() && isValidId(boardId);
    }

    match /boardItems/{itemId} {
      allow read, list: if isVerified();

      allow create: if isVerified() && isValidId(itemId) &&
                       incoming().keys().hasOnly(['id', 'boardId', 'x', 'y', 'cardId', 'width', 'height', 'groupId', 'groupColor', 'groupTitle', 'connectedTo']) &&
                       isValidBoardItemData(incoming());

      allow update: if isVerified() && isValidId(itemId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['boardId', 'x', 'y', 'cardId', 'width', 'height', 'groupId', 'groupColor', 'groupTitle', 'connectedTo']) &&
                       isValidBoardItemData(incoming()) &&
                       incoming().id == existing().id;

      allow delete: if isVerified() && isValidId(itemId);
    }

    match /agentEvents/{eventId} {
      allow read, list: if isVerified();

      allow create: if isVerified() && isValidId(eventId) &&
                       incoming().keys().hasOnly(['id', 'agent', 'cardId', 'status', 'createdAt', 'triggerType', 'description']) &&
                       isValidAgentEventData(incoming()) &&
                       incoming().createdAt == request.time;

      allow update: if isVerified() && isValidId(eventId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                       incoming().status in ['PENDING', 'PROCESSED'] &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().agent == existing().agent &&
                       incoming().cardId == existing().cardId;

      allow delete: if isVerified() && isValidId(eventId);
    }
  }
}
